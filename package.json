{
  "name": "coca-cola-event-intelligence-root",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "db:push": "cd backend && supabase db push",
    "db:migrations": "cd backend && supabase migration list",
    "db:types": "cd backend && supabase gen types typescript --linked > ../frontend/lib/database.types.ts"
  }
}
