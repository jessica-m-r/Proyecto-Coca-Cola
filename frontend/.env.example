NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Power BI (opcional). URL de inserción del reporte publicado, por ejemplo
# https://app.powerbi.com/reportEmbed?reportId=...&autoAuth=true&ctid=...
# Si se deja vacía, la vista "Power BI" muestra los pasos para conectarlo.
POWERBI_EMBED_URL=
# URL normal del reporte ya publicado en Power BI Service (no la de inserción), por ejemplo
# https://app.powerbi.com/reports/<reportId>/<pageName>. Es la que abre "Exportar › Abrir en Power BI";
# si se deja vacía, esa opción aparece deshabilitada y avisa que falta conectarla.
POWERBI_REPORT_URL=
# Tabla y columna del modelo de Power BI que contienen el ID del evento, por ejemplo
# v_dim_evento / event_id. Si alguna está vacía, el reporte se muestra sin filtrar.
POWERBI_FILTER_TABLE=
POWERBI_FILTER_COLUMN=

# Power BI Desktop lee la base con el rol de solo lectura powerbi_reader
# (usuario powerbi_reader.<project-ref>, esquema powerbi). La app no lo usa y su
# contraseña nunca va en .env ni en git: ver powerbi/README_WINDOWS.md.
